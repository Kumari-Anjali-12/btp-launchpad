{
  "_version": "1.59.0",
  "sap.app": {
    "id": "sap.btp.leave.leaverequests",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Employee Leave Requests",
    "description": "Fiori Elements application for Employee Leave Management",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/leave/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.btp.leave.leaverequests.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "LeaveRequestsList",
          "target": "LeaveRequestsList"
        },
        {
          "pattern": "LeaveRequests({key}):?query:",
          "name": "LeaveRequestsObjectPage",
          "target": "LeaveRequestsObjectPage"
        }
      ],
      "targets": {
        "LeaveRequestsList": {
          "type": "Component",
          "id": "LeaveRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "LeaveRequests",
              "initialLoad": "Enabled",
              "navigation": {
                "LeaveRequests": {
                  "detail": {
                    "route": "LeaveRequestsObjectPage"
                  }
                }
              }
            }
          }
        },
        "LeaveRequestsObjectPage": {
          "type": "Component",
          "id": "LeaveRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "LeaveRequests"
            }
          }
        }
      }
    }
  }
}
